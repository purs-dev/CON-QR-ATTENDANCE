{
  "name": "CON Attendance — SPCF College of Nursing",
  "short_name": "CON Attendance",
  "description": "QR-based session registration and attendance check-in system for the SPCF College of Nursing.",
  "id": "con-qr-attendance",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0A1F18",
  "theme_color": "#0B3D2E",
  "lang": "en",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "./images/icon-96.png", "sizes": "96x96", "type": "image/png" },
    { "src": "./images/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./images/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./images/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Attendance Scanner",
      "short_name": "Scanner",
      "description": "Scan student QR codes and check them in.",
      "url": "./scanner.html",
      "icons": [{ "src": "./images/icon-96.png", "sizes": "96x96" }]
    },
    {
      "name": "Register for a Session",
      "short_name": "Register",
      "description": "Register for a nursing session using a session link.",
      "url": "./register.html",
      "icons": [{ "src": "./images/icon-96.png", "sizes": "96x96" }]
    }
  ]
}
